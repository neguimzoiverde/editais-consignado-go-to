<div
  id="detail-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden"
  role="dialog"
  aria-modal="true"
>
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-full max-w-3xl max-h-[92vh] overflow-hidden flex flex-col shadow-2xl">
    <!-- Header Modal -->
    <div class="px-6 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-950/60">
      <div class="flex items-center gap-2.5">
        <span id="modal-uf-badge" class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          GO
        </span>
        <div>
          <h3 id="modal-title" class="text-base font-bold text-white">Detalhes do Chamamento Público</h3>
          <span id="modal-subhead" class="text-xs text-zinc-400">Credenciamento de Instituições Financeiras e Consignatárias</span>
        </div>
      </div>
      <button
        id="modal-close"
        class="text-zinc-400 hover:text-white p-1 rounded-lg hover:bg-zinc-800 transition"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Body Modal -->
    <div class="p-6 overflow-y-auto space-y-5 text-sm">
      <!-- Card: Município e Órgão -->
      <div class="bg-zinc-950 p-3.5 rounded-xl border border-zinc-800/80 flex items-center justify-between">
        <div>
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Município / Ente Federativo</span>
          <div id="modal-orgao" class="text-zinc-100 font-semibold text-sm mt-0.5"></div>
        </div>
        <div id="modal-chamamento-badge"></div>
      </div>

      <!-- Card: 16 Colunas - Matriz de Produtos e Prazos -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800/80">
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Edital / Ano</span>
          <div id="modal-numero" class="text-emerald-400 font-bold font-mono text-xs mt-1"></div>
        </div>
        <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800/80">
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Empréstimo</span>
          <div id="modal-emprestimo" class="font-bold text-xs mt-1"></div>
        </div>
        <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800/80">
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Cartão</span>
          <div id="modal-cartao" class="font-bold text-xs mt-1"></div>
        </div>
        <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800/80">
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Status</span>
          <div id="modal-situacao" class="mt-1"></div>
        </div>
      </div>

      <!-- Card: Prazos e Vigência -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="bg-zinc-950 p-3.5 rounded-xl border border-emerald-950/40">
          <span class="text-[10px] font-semibold text-emerald-400 uppercase tracking-wider block">Prazo para Novo Credenciamento</span>
          <div id="modal-prazo-cred" class="text-white font-bold text-sm mt-1"></div>
          <span class="text-[11px] text-zinc-500">Janela de envio de documentos e habilitação</span>
        </div>
        <div class="bg-zinc-950 p-3.5 rounded-xl border border-zinc-800/80">
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Datas Oficiais de Publicação</span>
          <div class="flex items-center gap-4 text-xs text-zinc-300 mt-1">
            <div>Publicação: <span id="modal-publicacao" class="font-mono text-zinc-200"></span></div>
            <div>Encerramento: <span id="modal-encerramento" class="font-mono text-zinc-200"></span></div>
          </div>
        </div>
      </div>

      <!-- Card: Parâmetros Operacionais e Financeiros -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="bg-zinc-950 p-3.5 rounded-xl border border-zinc-800/80 space-y-2">
          <div>
            <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Sistema de Averbação</span>
            <div id="modal-averbacao" class="text-zinc-200 text-xs font-semibold mt-0.5"></div>
          </div>
          <div>
            <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Margem Consignável</span>
            <div id="modal-margem" class="text-zinc-300 text-xs mt-0.5"></div>
          </div>
        </div>

        <div class="bg-zinc-950 p-3.5 rounded-xl border border-zinc-800/80 space-y-2">
          <div>
            <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Prazo Máximo (Parcelas)</span>
            <div id="modal-prazo-max" class="text-zinc-200 text-xs font-semibold mt-0.5"></div>
          </div>
          <div>
            <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Taxa de Juros / Limitação</span>
            <div id="modal-taxa" class="text-zinc-300 text-xs mt-0.5"></div>
          </div>
        </div>
      </div>

      <!-- Card: Bancos e Documentação -->
      <div class="bg-zinc-950 p-3.5 rounded-xl border border-zinc-800/80 space-y-2.5">
        <div>
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Bancos já Credenciados</span>
          <div id="modal-bancos" class="text-zinc-300 text-xs leading-relaxed mt-0.5"></div>
        </div>
        <div class="pt-2 border-t border-zinc-800/60">
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Documentação / Habilitação Exigida</span>
          <div id="modal-documentacao" class="text-zinc-400 text-xs leading-relaxed mt-0.5"></div>
        </div>
        <div class="pt-2 border-t border-zinc-800/60">
          <span class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block">Contato do Órgão / Setor Responsável</span>
          <div id="modal-contato" class="text-zinc-400 text-xs mt-0.5"></div>
        </div>
      </div>

      <!-- Objeto Completo -->
      <div>
        <label class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider block mb-1">Objeto Completo Identificado</label>
        <div id="modal-objeto" class="text-zinc-300 bg-zinc-950 p-3.5 rounded-xl border border-zinc-800/80 leading-relaxed text-xs"></div>
      </div>

      <!-- SEÇÃO EXCLUSIVA: RAIO-X DE SERVIDORES & POTENCIAL DE CONSIGNADO DA ENTIDADE -->
      <div id="modal-folha-container" class="bg-gradient-to-br from-zinc-950 via-zinc-900 to-zinc-950 p-4 rounded-xl border border-emerald-500/30 space-y-3.5 shadow-lg shadow-emerald-950/20">
        <div class="flex items-center justify-between border-b border-zinc-800/80 pb-2.5">
          <div class="flex items-center gap-2">
            <div class="h-6 w-6 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-xs">
              🏛️
            </div>
            <div>
              <span class="text-xs font-bold text-white uppercase tracking-wider">Raio-X de Servidores & Potencial de Consignado</span>
              <span id="modal-folha-sub" class="text-[11px] text-zinc-400 block">Inteligência de Folha de Pagamento Municipal</span>
            </div>
          </div>
          <span id="modal-folha-competencia" class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            Competência: 2026-10
          </span>
        </div>

        <!-- Grid de 4 Métricas de Negócio -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          <div class="bg-zinc-950/80 p-2.5 rounded-lg border border-zinc-800">
            <span class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider block">Total Servidores</span>
            <div id="modal-folha-total" class="text-base font-extrabold text-white font-mono mt-0.5">—</div>
            <span id="modal-folha-efetivos-pct" class="text-[10px] text-emerald-400 font-semibold block mt-0.5">85% Concursados</span>
          </div>

          <div class="bg-zinc-950/80 p-2.5 rounded-lg border border-zinc-800">
            <span class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider block">Elegíveis Consignado</span>
            <div id="modal-folha-elegiveis" class="text-base font-extrabold text-emerald-400 font-mono mt-0.5">—</div>
            <span class="text-[10px] text-zinc-500 block mt-0.5">Efetivos + RPPS</span>
          </div>

          <div class="bg-zinc-950/80 p-2.5 rounded-lg border border-zinc-800">
            <span class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider block">Folha Mensal Bruta</span>
            <div id="modal-folha-bruta" class="text-xs font-bold text-zinc-200 font-mono mt-1">—</div>
            <span id="modal-folha-liquida" class="text-[10px] text-zinc-500 block mt-0.5">Líquido: —</span>
          </div>

          <div class="bg-emerald-950/30 p-2.5 rounded-lg border border-emerald-500/40">
            <span class="text-[10px] font-bold text-emerald-300 uppercase tracking-wider block">Margem 35% + 5%</span>
            <div id="modal-folha-margem" class="text-xs font-black text-emerald-400 font-mono mt-1">—</div>
            <span id="modal-folha-cartao" class="text-[10px] text-emerald-400/80 block mt-0.5">Cartão: —</span>
          </div>
        </div>

        <!-- Barra Visual de Distribuição de Vínculos -->
        <div class="space-y-1">
          <div class="flex items-center justify-between text-[11px] text-zinc-400">
            <span>Composição: <span id="modal-breakdown-text" class="text-zinc-200">Efetivos vs Comissionados vs Temporários</span></span>
            <span id="modal-folha-fonte" class="text-[10px] text-zinc-500">Fonte: Transparência Municipal</span>
          </div>
          <div class="w-full h-2 rounded-full bg-zinc-800 flex overflow-hidden">
            <div id="modal-bar-efetivos" class="bg-emerald-500 h-full" style="width: 75%;" title="Efetivos"></div>
            <div id="modal-bar-aposentados" class="bg-blue-500 h-full" style="width: 12%;" title="Aposentados/Pensionistas"></div>
            <div id="modal-bar-comissionados" class="bg-purple-500 h-full" style="width: 9%;" title="Comissionados"></div>
            <div id="modal-bar-temporarios" class="bg-amber-500 h-full" style="width: 4%;" title="Temporários"></div>
          </div>
          <div class="flex items-center gap-3 text-[10px] text-zinc-400 pt-0.5">
            <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Efetivos</span>
            <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> Inativos/RPPS</span>
            <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span> Comissionados</span>
            <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Temporários</span>
          </div>
        </div>

        <!-- Links e Plataforma de Transparência -->
        <div class="pt-2 border-t border-zinc-800/80 flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2">
            <span id="modal-folha-sistema" class="px-2 py-0.5 rounded text-[10px] font-bold bg-zinc-800 text-zinc-300 border border-zinc-700">
              Transparência Municipal
            </span>
            <span id="modal-folha-tce-nome" class="px-2 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
              Tribunal de Contas
            </span>
          </div>

          <div class="flex items-center gap-2">
            <a
              id="modal-btn-folha"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 text-xs font-bold transition shadow-sm cursor-pointer"
            >
              <span>🌐 Folha de Pagamento</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <a
              id="modal-btn-tce"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-xs font-semibold transition cursor-pointer"
            >
              <span>🏛️ Consultar TCE</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- SEÇÃO EXCLUSIVA DE LINKS HIERÁRQUICOS (1º Chamamento -> 2º Compras -> 3º Edital) -->
      <div class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-zinc-200 uppercase tracking-wider flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            Links e Documentos Oficiais por Ordem de Prioridade
          </span>
          <span class="text-[11px] text-zinc-500">Prioridade de Acesso do Departamento</span>
        </div>

        <div class="space-y-2.5">
          <!-- 1º Grau: Chamamento Público (Documento Direto) -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-emerald-950/20 border border-emerald-500/30 gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-black bg-emerald-500 text-zinc-950 uppercase tracking-wider">1º Prioridade</span>
                <span class="text-xs font-bold text-emerald-300">Chamamento Público (Documento Direto)</span>
              </div>
              <span class="text-[11px] text-zinc-400 block mt-1">Link direto para download do arquivo (PDF/anexo) para dar andamento no processo</span>
            </div>
            <div id="modal-slot-chamamento"></div>
          </div>

          <!-- 2º Grau: Portal de Compras Públicas / Prefeitura -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-cyan-950/20 border border-cyan-500/30 gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-black bg-cyan-500 text-zinc-950 uppercase tracking-wider">2º Prioridade</span>
                <span class="text-xs font-bold text-cyan-300">Portal de Compras Públicas / Prefeitura</span>
              </div>
              <span class="text-[11px] text-zinc-400 block mt-1">Plataforma eletrônica de compras ou portal municipal onde corre a sessão</span>
            </div>
            <div id="modal-slot-compras"></div>
          </div>

          <!-- 3º Grau: Edital / PNCP -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 rounded-xl bg-zinc-900 border border-zinc-700/60 gap-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-zinc-700 text-zinc-200 uppercase tracking-wider">3º Prioridade</span>
                <span class="text-xs font-semibold text-zinc-300">Edital / Publicação Oficial (PNCP)</span>
              </div>
              <span class="text-[11px] text-zinc-400 block mt-1">Página do certame no Portal Nacional de Contratações Públicas</span>
            </div>
            <div id="modal-slot-edital"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Modal com Múltiplos Links -->
    <div class="px-6 py-3.5 border-t border-zinc-800 bg-zinc-950/80 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div id="modal-origem" class="text-[11px] text-zinc-500"></div>
      <div class="flex flex-wrap items-center gap-2">
        <!-- Botão Portal da Prefeitura -->
        <a
          id="modal-link-prefeitura"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 transition"
        >
          <span>Portal da Prefeitura</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <!-- Botão Secundário / Diário Oficial -->
        <a
          id="modal-link-secundario"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 transition"
        >
          <span id="modal-link-secundario-text">Diário Oficial</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <!-- Botão Oficial PNCP -->
        <a
          id="modal-link-oficial"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition font-bold"
        >
          <span id="modal-link-oficial-text">Abrir no PNCP</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

---
interface Props {
  stats: {
    total: number;
    abertosGO: number;
    abertosTO: number;
    novosHoje: number;
    retificados: number;
  };
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-5 gap-3 sm:gap-4 mb-6">
  <!-- Total Geral -->
  <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-3.5 sm:p-4 backdrop-blur-sm shadow-sm hover:border-zinc-700 transition">
    <div class="flex items-center justify-between text-zinc-400 mb-1">
      <span class="text-xs font-medium uppercase tracking-wider">Total Monitorado</span>
      <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-white" id="stat-total">{stats.total}</div>
    <p class="text-[11px] text-zinc-500 mt-1">Goiás & Tocantins</p>
  </div>

  <!-- Abertos GO -->
  <div class="bg-zinc-900/80 border border-emerald-900/40 rounded-xl p-3.5 sm:p-4 backdrop-blur-sm shadow-sm hover:border-emerald-700/50 transition">
    <div class="flex items-center justify-between text-emerald-400 mb-1">
      <span class="text-xs font-medium uppercase tracking-wider">Abertos GO</span>
      <span class="text-xs font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">GO</span>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-emerald-300" id="stat-abertos-go">{stats.abertosGO}</div>
    <p class="text-[11px] text-zinc-500 mt-1">Prazo de proposta ativo</p>
  </div>

  <!-- Abertos TO -->
  <div class="bg-zinc-900/80 border border-teal-900/40 rounded-xl p-3.5 sm:p-4 backdrop-blur-sm shadow-sm hover:border-teal-700/50 transition">
    <div class="flex items-center justify-between text-teal-400 mb-1">
      <span class="text-xs font-medium uppercase tracking-wider">Abertos TO</span>
      <span class="text-xs font-bold px-1.5 py-0.5 rounded bg-teal-500/10 border border-teal-500/20">TO</span>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-teal-300" id="stat-abertos-to">{stats.abertosTO}</div>
    <p class="text-[11px] text-zinc-500 mt-1">Prazo de proposta ativo</p>
  </div>

  <!-- Novos Hoje -->
  <div class="bg-zinc-900/80 border border-indigo-900/40 rounded-xl p-3.5 sm:p-4 backdrop-blur-sm shadow-sm hover:border-indigo-700/50 transition">
    <div class="flex items-center justify-between text-indigo-400 mb-1">
      <span class="text-xs font-medium uppercase tracking-wider">Novos Hoje</span>
      <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-indigo-300" id="stat-novos">{stats.novosHoje}</div>
    <p class="text-[11px] text-zinc-500 mt-1">Capturados na rodada</p>
  </div>

  <!-- Retificados / Alterações -->
  <div class="bg-zinc-900/80 border border-amber-900/40 rounded-xl p-3.5 sm:p-4 backdrop-blur-sm shadow-sm hover:border-amber-700/50 transition col-span-2 md:col-span-1">
    <div class="flex items-center justify-between text-amber-400 mb-1">
      <span class="text-xs font-medium uppercase tracking-wider">Retificados</span>
      <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
    </div>
    <div class="text-2xl sm:text-3xl font-extrabold text-amber-300" id="stat-retificados">{stats.retificados}</div>
    <p class="text-[11px] text-zinc-500 mt-1">Republicações / aditivos</p>
  </div>
</div>

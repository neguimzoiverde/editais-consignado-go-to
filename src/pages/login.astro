---
import Layout from '../layouts/Layout.astro';

// Se o usuário já estiver com sessão ativa, redireciona para a página principal
if (Astro.locals.user) {
  return Astro.redirect('/');
}
---

<Layout title="Acesso Restrito — Monitor de Editais de Consignado">
  <div class="flex items-center justify-center min-h-screen px-4 py-12 relative z-10">
    <div class="w-full max-w-md">
      <!-- Card Central -->
      <div class="bg-zinc-900/90 border border-zinc-800/90 rounded-3xl p-8 sm:p-10 shadow-2xl shadow-black/80 backdrop-blur-xl relative overflow-hidden">
        <!-- Glow Decorativo de Fundo -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Cabeçalho do Card -->
        <div class="flex flex-col items-center text-center mb-8 relative z-10">
          <div class="h-14 w-14 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-400 p-0.5 shadow-xl shadow-emerald-500/20 mb-4 flex-shrink-0">
            <div class="h-full w-full bg-zinc-950 rounded-[14px] flex items-center justify-center">
              <svg class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
          </div>

          <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Acesso Restrito</h1>
          <p class="text-xs sm:text-sm text-zinc-400 mt-1">
            Monitor de Editais e Chamamentos de Consignado
          </p>
          <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Ambiente Seguro & Criptografado</span>
          </div>
        </div>

        <!-- Banner de Erro -->
        <div id="login-error-banner" class="hidden mb-6 p-3.5 rounded-xl bg-red-950/50 border border-red-500/40 text-red-300 text-xs flex items-start gap-2.5">
          <svg class="w-4 h-4 text-red-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span id="login-error-text">Credenciais inválidas.</span>
        </div>

        <!-- Formulário de Login -->
        <form id="login-form" class="space-y-4 relative z-10" autocomplete="on">
          <div>
            <label for="email" class="block text-xs font-semibold text-zinc-300 mb-1.5">
              E-mail corporativo
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206" />
                </svg>
              </div>
              <input
                type="email"
                id="email"
                name="email"
                required
                autofocus
                placeholder="rodrigo.pwn@gmail.com"
                class="w-full pl-10 pr-4 py-2.5 bg-zinc-950/80 border border-zinc-700/80 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-xl text-sm text-zinc-100 placeholder-zinc-500 transition outline-none"
              />
            </div>
          </div>

          <div>
            <label for="password" class="block text-xs font-semibold text-zinc-300 mb-1.5">
              Senha de acesso
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="••••••••••••"
                class="w-full pl-10 pr-10 py-2.5 bg-zinc-950/80 border border-zinc-700/80 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 rounded-xl text-sm text-zinc-100 placeholder-zinc-500 transition outline-none font-mono"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-400 hover:text-zinc-200 transition cursor-pointer"
                title="Mostrar / Ocultar senha"
              >
                <svg id="eye-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="login-submit-btn"
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-zinc-950 transition-all shadow-lg shadow-emerald-500/25 active:scale-[0.98] cursor-pointer"
            >
              <svg id="login-spinner" class="w-4 h-4 hidden animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span id="login-btn-text">Entrar no Sistema</span>
            </button>
          </div>
        </form>

        <!-- Rodapé do Card -->
        <div class="mt-8 pt-6 border-t border-zinc-800/60 text-center">
          <p class="text-[11px] text-zinc-500 flex items-center justify-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Proteção contra rastreadores e inteligência artificial</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-password') as HTMLButtonElement;
  const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement;
  const spinner = document.getElementById('login-spinner') as HTMLElement;
  const btnText = document.getElementById('login-btn-text') as HTMLElement;
  const errorBanner = document.getElementById('login-error-banner') as HTMLElement;
  const errorText = document.getElementById('login-error-text') as HTMLElement;

  // Alternar visualização da senha
  toggleBtn?.addEventListener('click', () => {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
    } else {
      passwordInput.type = 'password';
    }
  });

  // Submissão do login via fetch assíncrono
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBanner.classList.add('hidden');

    const email = emailInput.value.trim();
    const password = passwordInput.value;

    if (!email || !password) return;

    submitBtn.disabled = true;
    spinner.classList.remove('hidden');
    btnText.textContent = 'Autenticando...';

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Credenciais inválidas.');
      }

      // Sucesso: redireciona para a aplicação
      window.location.href = data.redirect || '/';
    } catch (err: any) {
      errorText.textContent = err.message || 'Falha ao autenticar.';
      errorBanner.classList.remove('hidden');
      submitBtn.disabled = false;
      spinner.classList.add('hidden');
      btnText.textContent = 'Entrar no Sistema';
      passwordInput.focus();
    }
  });
</script>

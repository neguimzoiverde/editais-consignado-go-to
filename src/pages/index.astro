---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MetricCards from '../components/MetricCards.astro';
import DetailModal from '../components/DetailModal.astro';
import ReportModal from '../components/ReportModal.astro';
import { listEditais, getStats, getLastSync, listFolhaStats } from '../lib/db/database.js';
import { initScheduler } from '../lib/collector/scheduler.js';
import { BRAZIL_STATES, REGIONS } from '../lib/config.js';

// Inicializa agendador de segundo plano
initScheduler();

const initialEditais = listEditais();
const stats = getStats();
const lastSync = getLastSync();
const initialFolhaStats = listFolhaStats();
---

<Layout title="Monitor de Editais de Consignado — Brasil (27 UFs)">
  <Header lastSyncTime={lastSync?.timestamp} />

  <main class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full flex-1">
    <!-- Top KPI Cards -->
    <MetricCards stats={stats} />

    <!-- Navegação de Abas -->
    <div class="flex items-center gap-2 mb-6 border-b border-zinc-800 pb-3">
      <button
        id="tab-btn-editais"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm bg-emerald-500 text-zinc-950 shadow-md shadow-emerald-500/10 transition cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Editais & Chamamentos</span>
        <span id="tab-badge-editais" class="px-2 py-0.5 rounded text-[11px] bg-zinc-950/40 text-zinc-950 font-mono font-extrabold">{initialEditais.length}</span>
      </button>

      <button
        id="tab-btn-prefeituras"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm bg-zinc-900/60 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        <span>Catálogo de Prefeituras (5.571 Municípios)</span>
        <span class="px-2 py-0.5 rounded text-[11px] bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-mono">5.571</span>
      </button>

      <button
        id="tab-btn-servidores"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm bg-zinc-900/60 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span>Servidores & Transparência</span>
        <span class="px-2 py-0.5 rounded text-[11px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono font-bold">Brasil</span>
      </button>
    </div>

    <!-- ABA 1: EDITAIS E CHAMAMENTOS -->
    <section id="view-editais" class="space-y-6">
      <!-- Barra de Filtros e Ações -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-4 backdrop-blur-sm shadow-sm space-y-4">
        <!-- Linha 1: Campo de Busca e Exportação -->
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="search-input"
              placeholder="Buscar por município, órgão, edital ou palavra do objeto..."
              class="w-full pl-10 pr-4 py-2 bg-zinc-950 border border-zinc-800 rounded-xl text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 transition"
            />
          </div>

          <!-- Export Dropdown -->
          <div class="relative inline-block text-left" id="export-dropdown-wrapper">
            <button
              id="export-btn"
              type="button"
              class="inline-flex items-center justify-center gap-2 w-full md:w-auto px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-100 text-xs font-semibold rounded-xl border border-zinc-700 transition shadow-sm cursor-pointer"
            >
              <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Exportar Resultados (16 Colunas)</span>
              <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              id="export-menu"
              class="hidden absolute right-0 mt-2 w-64 rounded-xl bg-zinc-900 border border-zinc-800 shadow-xl py-1 z-30"
            >
              <a
                href="/api/export?format=markdown"
                download
                class="flex items-center gap-2 px-4 py-2.5 text-xs text-zinc-200 hover:bg-zinc-800/80 hover:text-emerald-400 transition"
              >
                <span class="font-mono text-emerald-500 font-bold">.md</span>
                <span>Relatório Oficial 16 Colunas (Markdown)</span>
              </a>
              <a
                href="/api/export?format=csv"
                download
                class="flex items-center gap-2 px-4 py-2.5 text-xs text-zinc-200 hover:bg-zinc-800/80 hover:text-emerald-400 transition border-t border-zinc-800/50"
              >
                <span class="font-mono text-emerald-500 font-bold">.csv</span>
                <span>Planilha Formatada (Excel UTF-8)</span>
              </a>
              <a
                href="/api/export?format=json"
                download
                class="flex items-center gap-2 px-4 py-2.5 text-xs text-zinc-200 hover:bg-zinc-800/80 hover:text-emerald-400 transition border-t border-zinc-800/50"
              >
                <span class="font-mono text-emerald-500 font-bold">.json</span>
                <span>Exportar Estrutura Completa (JSON)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Linha 2: Filtros de Prioridade e Escopo -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-zinc-800/50">
          <!-- Prioridade: Chamamentos Públicos -->
          <div class="flex items-center gap-2" id="chamamento-filter-group">
            <span class="text-xs text-zinc-400 font-medium">Modalidade:</span>
            <button
              id="btn-filter-chamamento-only"
              class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-lg bg-emerald-500 text-zinc-950 transition cursor-pointer"
            >
              <span>⭐ Apenas Chamamentos / Credenciamento</span>
            </button>
            <button
              id="btn-filter-chamamento-all"
              class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer"
            >
              <span>Todos os Editais</span>
            </button>
          </div>

          <!-- Filtro Situação -->
          <div class="flex items-center gap-1.5" id="situacao-filters">
            <span class="text-xs text-zinc-400 font-medium mr-1">Situação:</span>
            <button data-situacao="ALL" class="filter-sit-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-800 text-zinc-100 transition cursor-pointer">Todas</button>
            <button data-situacao="aberto" class="filter-sit-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-emerald-400 hover:bg-emerald-500/10 border border-zinc-800 transition cursor-pointer">Aberto</button>
            <button data-situacao="retificado" class="filter-sit-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-amber-400 hover:bg-amber-500/10 border border-zinc-800 transition cursor-pointer">Retificado</button>
            <button data-situacao="suspenso" class="filter-sit-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-purple-400 hover:bg-purple-500/10 border border-zinc-800 transition cursor-pointer">Suspenso</button>
            <button data-situacao="encerrado" class="filter-sit-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">Encerrado</button>
          </div>
        </div>

        <!-- Linha 3: Filtro Geográfico Brasil (27 UFs e Regiões) -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-zinc-800/50">
          <span class="text-xs text-zinc-400 font-medium mr-1">Estado / UF:</span>
          <!-- Pílulas rápidas -->
          <button data-uf="ALL" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-emerald-500 text-zinc-950 transition cursor-pointer">Brasil</button>
          <button data-uf="GO" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">GO</button>
          <button data-uf="TO" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">TO</button>
          <button data-uf="SP" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">SP</button>
          <button data-uf="MG" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">MG</button>
          <button data-uf="BA" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">BA</button>
          <button data-uf="PR" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">PR</button>
          <button data-uf="RJ" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">RJ</button>
          <button data-uf="SC" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">SC</button>
          <button data-uf="RS" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">RS</button>
          <button data-uf="MT" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">MT</button>
          <button data-uf="MS" class="filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer">MS</button>

          <!-- Seletor Completo 27 UFs -->
          <div class="ml-auto flex items-center gap-2">
            <span class="text-xs text-zinc-500">Todas as UFs:</span>
            <select
              id="state-select"
              class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-200 focus:outline-none focus:border-emerald-500 transition cursor-pointer"
            >
              <option value="ALL">27 Estados (Nacional)</option>
              {Object.entries(REGIONS).map(([regCode, reg]) => (
                <optgroup label={reg.nome}>
                  {reg.ufs.map((uf) => (
                    <option value={uf}>{uf} — {reg.nome}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Tabela de Resultados -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl overflow-hidden backdrop-blur-sm shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full min-w-[1180px] text-left border-collapse text-xs">
            <thead>
              <tr class="bg-zinc-950/80 border-b border-zinc-800 text-zinc-400 font-semibold uppercase tracking-wider text-[11px]">
                <th class="py-3.5 px-4 w-36 whitespace-nowrap cursor-pointer select-none group/th hover:bg-zinc-800/40 hover:text-zinc-200 transition" data-sort="municipio" title="Clique para ordenar por Município/UF">
                  <div class="flex items-center gap-1.5">
                    <span>Município / UF</span>
                    <span class="sort-icon inline-flex text-zinc-600 group-hover/th:text-zinc-400" data-sort-icon="municipio"></span>
                  </div>
                </th>
                <th class="py-3.5 px-4 w-36 whitespace-nowrap cursor-pointer select-none group/th hover:bg-zinc-800/40 hover:text-zinc-200 transition" data-sort="numero_edital" title="Clique para ordenar por Edital / Ano">
                  <div class="flex items-center gap-1.5">
                    <span>Edital / Ano</span>
                    <span class="sort-icon inline-flex text-zinc-600 group-hover/th:text-zinc-400" data-sort-icon="numero_edital"></span>
                  </div>
                </th>
                <th class="py-3.5 px-4 min-w-[240px] whitespace-nowrap cursor-pointer select-none group/th hover:bg-zinc-800/40 hover:text-zinc-200 transition" data-sort="objeto" title="Clique para ordenar por Objeto">
                  <div class="flex items-center gap-1.5">
                    <span>Objeto Identificado</span>
                    <span class="sort-icon inline-flex text-zinc-600 group-hover/th:text-zinc-400" data-sort-icon="objeto"></span>
                  </div>
                </th>
                <th class="py-3.5 px-3 w-20 whitespace-nowrap text-center">
                  <span>Empréstimo</span>
                </th>
                <th class="py-3.5 px-3 w-28 whitespace-nowrap text-center">
                  <span>Cartão</span>
                </th>
                <th class="py-3.5 px-4 w-32 whitespace-nowrap cursor-pointer select-none group/th hover:bg-zinc-800/40 hover:text-zinc-200 transition text-center" data-sort="prazo_credenciamento" title="Clique para ordenar por Prazo de Credenciamento">
                  <div class="flex items-center justify-center gap-1.5">
                    <span>Prazo Credenciamento</span>
                    <span class="sort-icon inline-flex text-zinc-600 group-hover/th:text-zinc-400" data-sort-icon="prazo_credenciamento"></span>
                  </div>
                </th>
                <th class="py-3.5 px-4 w-24 whitespace-nowrap cursor-pointer select-none group/th hover:bg-zinc-800/40 hover:text-zinc-200 transition text-center" data-sort="situacao" title="Clique para ordenar por Status">
                  <div class="flex items-center justify-center gap-1.5">
                    <span>Status</span>
                    <span class="sort-icon inline-flex text-zinc-600 group-hover/th:text-zinc-400" data-sort-icon="situacao"></span>
                  </div>
                </th>
                <th class="py-3.5 px-4 w-64 whitespace-nowrap text-right">Links do Processo (Prioridade)</th>
              </tr>
            </thead>
            <tbody id="table-body" class="divide-y divide-zinc-800/60 text-zinc-300">
              <!-- Linhas renderizadas no cliente a partir do JSON embutido -->
            </tbody>
          </table>
        </div>

        <!-- Empty State -->
        <div id="empty-state" class="hidden py-16 px-4 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-zinc-800 text-zinc-400 mb-3">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h4 class="text-sm font-bold text-zinc-200 mb-1">Nenhum edital localizado para os filtros atuais</h4>
          <p class="text-xs text-zinc-500 max-w-sm mx-auto mb-4">
            Tente selecionar "Todos os Editais", alterar a UF ou clicar no botão abaixo para disparar uma nova varredura oficial.
          </p>
          <button
            onclick="document.getElementById('btn-sync-now').click()"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition cursor-pointer"
          >
            Disparar Varredura Multi-Fonte Agora
          </button>
        </div>

        <!-- Footer da Tabela com contador -->
        <div class="px-4 py-3 bg-zinc-950/60 border-t border-zinc-800 text-xs text-zinc-400 flex items-center justify-between">
          <div id="results-count">Exibindo 0 resultados</div>
          <div class="text-[11px] text-zinc-500">Matriz oficial com 16 atributos de consignação · Brasil (27 UFs)</div>
        </div>
      </div>
    </section>

    <!-- ABA 2: CATÁLOGO DE PREFEITURAS (5.571 MUNICÍPIOS) -->
    <section id="view-prefeituras" class="hidden space-y-6">
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-4 backdrop-blur-sm shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="search-pref-input"
              placeholder="Buscar prefeitura por nome do município ou código IBGE..."
              class="w-full pl-10 pr-4 py-2 bg-zinc-950 border border-zinc-800 rounded-xl text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/50 transition"
            />
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs text-zinc-400">UF:</span>
            <select
              id="pref-uf-select"
              class="px-3 py-2 text-xs font-semibold rounded-xl bg-zinc-950 border border-zinc-800 text-zinc-200 focus:outline-none focus:border-cyan-500 transition"
            >
              <option value="ALL">Todas as UFs (5.571)</option>
              {Object.entries(REGIONS).map(([regCode, reg]) => (
                <optgroup label={reg.nome}>
                  {reg.ufs.map((uf) => (
                    <option value={uf}>{uf} — {reg.nome}</option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Tabela do Catálogo -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl overflow-hidden backdrop-blur-sm shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-zinc-950/80 border-b border-zinc-800 text-zinc-400 font-semibold uppercase tracking-wider text-[11px]">
                <th class="py-3 px-4 w-44">Município</th>
                <th class="py-3 px-3 w-16 text-center">UF</th>
                <th class="py-3 px-3 w-28">Região</th>
                <th class="py-3 px-3 w-24 font-mono">IBGE</th>
                <th class="py-3 px-4">Portal Oficial (.gov.br)</th>
                <th class="py-3 px-4">Portal de Licitações</th>
                <th class="py-3 px-3 w-24 text-center">Status</th>
              </tr>
            </thead>
            <tbody id="pref-table-body" class="divide-y divide-zinc-800/60 text-zinc-300">
              <tr>
                <td colspan="7" class="py-8 text-center text-zinc-500">Carregando catálogo de municípios...</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="px-4 py-3 bg-zinc-950/60 border-t border-zinc-800 text-xs text-zinc-400 flex items-center justify-between">
          <div id="pref-results-count">Carregando...</div>
          <div class="text-[11px] text-zinc-500">Base oficial do IBGE com resolução de domínios municipais</div>
        </div>
      </div>
    </section>

    <!-- ABA 3: SERVIDORES & TRANSPARÊNCIA MUNICIPAL -->
    <section id="view-servidores" class="hidden space-y-6">
      <!-- Banner Informativo de Inteligência de Folha -->
      <div class="bg-gradient-to-r from-emerald-950/40 via-zinc-900/80 to-zinc-900/80 border border-emerald-500/30 rounded-2xl p-5 backdrop-blur-sm shadow-xl">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 uppercase tracking-wider">
                Módulo Nacional
              </span>
              <h2 class="text-base font-bold text-white">Inteligência de Folha & Servidores Públicos (Brasil)</h2>
            </div>
            <p class="text-xs text-zinc-400 max-w-3xl leading-relaxed">
              Mapeamento de quadro funcional municipal, massa salarial e margens consignáveis legais (35% Empréstimo + 5% Cartão Benefício). Dados consolidados via Portais de Transparência e SICONFI/Tesouro Nacional para suporte a decisões de crédito e participação em chamamentos.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="btn-sync-all-folha"
              type="button"
              class="inline-flex items-center gap-2 px-3.5 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 text-xs font-bold rounded-xl transition shadow-sm cursor-pointer whitespace-nowrap"
            >
              <svg id="sync-folha-spinner" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span id="sync-folha-text">Sincronizar Folha Ativa</span>
            </button>
          </div>
        </div>

        <!-- 4 KPI Cards de Folha -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4 pt-4 border-t border-zinc-800/80">
          <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800">
            <span class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider block">Servidores Mapeados</span>
            <div id="kpi-folha-servidores" class="text-lg font-black text-white font-mono mt-0.5">—</div>
            <span id="kpi-folha-sub-servidores" class="text-[10px] text-zinc-500 block">Municípios monitorados</span>
          </div>

          <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800">
            <span class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider block">Elegíveis Consignado</span>
            <div id="kpi-folha-elegiveis" class="text-lg font-black text-emerald-400 font-mono mt-0.5">—</div>
            <span class="text-[10px] text-zinc-500 block">Efetivos / Concursados + RPPS</span>
          </div>

          <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800">
            <span class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider block">Massa Salarial Estimada</span>
            <div id="kpi-folha-massa" class="text-lg font-black text-zinc-200 font-mono mt-0.5">—</div>
            <span class="text-[10px] text-zinc-500 block">Folha mensal bruta calculada</span>
          </div>

          <div class="bg-emerald-950/30 p-3 rounded-xl border border-emerald-500/30">
            <span class="text-[10px] font-bold text-emerald-300 uppercase tracking-wider block">Potencial Margem 35%</span>
            <div id="kpi-folha-margem" class="text-lg font-black text-emerald-400 font-mono mt-0.5">—</div>
            <span id="kpi-folha-cartao" class="text-[10px] text-emerald-400/80 block">+ 5% Cartão Benefício</span>
          </div>
        </div>
      </div>

      <!-- Barra de Filtro de Servidores -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-4 backdrop-blur-sm shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="search-serv-input"
              placeholder="Filtrar por município ou estado..."
              class="w-full pl-10 pr-4 py-2 bg-zinc-950 border border-zinc-800 rounded-xl text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 transition"
            />
          </div>

          <div class="flex items-center gap-2">
            <label for="serv-uf-select" class="text-xs text-zinc-400 whitespace-nowrap">Filtrar UF:</label>
            <select
              id="serv-uf-select"
              class="px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-xl text-xs text-zinc-200 focus:outline-none focus:border-emerald-500/50 transition"
            >
              <option value="ALL">Todas as UFs (Brasil)</option>
              {BRAZIL_STATES.map(uf => (
                <option value={uf}>{uf}</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Tabela de Servidores & Margens Consignáveis -->
      <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl overflow-hidden backdrop-blur-sm shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-zinc-950/80 border-b border-zinc-800 text-zinc-400 font-semibold uppercase tracking-wider text-[11px]">
                <th class="py-3 px-4 w-44">Município / UF</th>
                <th class="py-3 px-3 w-32 text-right font-mono">Total Servidores</th>
                <th class="py-3 px-4 w-56">Composição de Vínculos</th>
                <th class="py-3 px-3 w-36 text-right font-mono">Folha Mensal (Bruta)</th>
                <th class="py-3 px-3 w-36 text-right font-mono">Margem 35% (Empréstimo)</th>
                <th class="py-3 px-3 w-32 text-right font-mono">Cartão 5%</th>
                <th class="py-3 px-3 w-28 text-center font-mono">Competência</th>
                <th class="py-3 px-3 w-28 text-center">Ações</th>
              </tr>
            </thead>
            <tbody id="serv-table-body" class="divide-y divide-zinc-800/60 text-zinc-300">
              <tr>
                <td colspan="8" class="py-8 text-center text-zinc-500">Carregando dados de servidores e transparência...</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="px-4 py-3 bg-zinc-950/60 border-t border-zinc-800 text-xs text-zinc-400 flex items-center justify-between">
          <div id="serv-results-count">Carregando...</div>
          <div class="text-[11px] text-zinc-500">Dados integrados aos editais de chamamento e credenciamento de consignado</div>
        </div>
      </div>
    </section>
  </main>

  <!-- Modais -->
  <DetailModal />
  <ReportModal />

  <!-- Dados Iniciais embutidos para Renderização Instantânea -->
  <script id="initial-data" type="application/json" set:html={JSON.stringify(initialEditais)} />
  <script id="initial-folha-data" type="application/json" set:html={JSON.stringify(initialFolhaStats)} />

  <!-- Lógica Reativa do Cliente -->
  <script is:inline>
    let allEditais = [];
    try {
      const el = document.getElementById('initial-data');
      if (el) allEditais = JSON.parse(el.textContent || '[]');
    } catch (e) {
      console.error('Erro ao ler dados iniciais:', e);
    }

    let allFolhaStats = [];
    try {
      const elFolha = document.getElementById('initial-folha-data');
      if (elFolha) allFolhaStats = JSON.parse(elFolha.textContent || '[]');
    } catch (e) {
      console.error('Erro ao ler dados de folha:', e);
    }

    function getFolhaForMunicipio(municipio, uf) {
      if (!municipio) return null;
      const mNorm = municipio.trim().toLowerCase();
      const ufNorm = (uf || '').trim().toUpperCase();
      return allFolhaStats.find(f => {
        const fMun = (f.municipio || '').trim().toLowerCase();
        const fUf = (f.uf || '').trim().toUpperCase();
        if (ufNorm) {
          return fMun === mNorm && fUf === ufNorm;
        }
        return fMun === mNorm;
      }) || null;
    }

    let activeTab = 'editais';
    let activeChamamentoOnly = true; // Por padrão, prioriza chamamento público
    let activeUf = 'ALL';
    let activeSituacao = 'ALL';
    let searchQuery = '';
    let currentSortColumn = 'prazo_credenciamento';
    let currentSortDirection = 'desc';

    // Estado da Aba Catálogo de Prefeituras
    let prefSearchQuery = '';
    let prefActiveUf = 'ALL';
    let prefeiturasList = [];

    // Estado da Aba Servidores & Transparência
    let servSearchQuery = '';
    let servActiveUf = 'ALL';

    function parseDateValue(str) {
      if (!str) return 0;
      const s = String(str).trim();
      const brMatch = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
      if (brMatch) {
        const day = parseInt(brMatch[1], 10);
        const month = parseInt(brMatch[2], 10) - 1;
        const year = parseInt(brMatch[3], 10);
        return new Date(year, month, day).getTime();
      }
      const t = Date.parse(s);
      return isNaN(t) ? 0 : t;
    }

    function updateSortIcons() {
      const neutralSvg = '<svg class="w-3.5 h-3.5 text-zinc-600 group-hover/th:text-zinc-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 10l5-5 5 5M7 14l5 5 5-5" /></svg>';
      const ascSvg = '<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" /></svg>';
      const descSvg = '<svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>';

      document.querySelectorAll('th[data-sort]').forEach(th => {
        const col = th.getAttribute('data-sort');
        const iconContainer = th.querySelector('[data-sort-icon]');
        if (!iconContainer) return;

        if (col === currentSortColumn) {
          iconContainer.innerHTML = currentSortDirection === 'asc' ? ascSvg : descSvg;
          th.classList.add('text-emerald-400');
          th.classList.remove('text-zinc-400');
        } else {
          iconContainer.innerHTML = neutralSvg;
          th.classList.remove('text-emerald-400');
          th.classList.add('text-zinc-400');
        }
      });
    }

    function getSituacaoBadge(situacao) {
      const s = (situacao || '').toLowerCase();
      if (s === 'aberto' || s === 'em andamento') {
        return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Aberto</span>';
      } else if (s === 'retificado') {
        return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">Retificado</span>';
      } else if (s === 'suspenso') {
        return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20">Suspenso</span>';
      } else if (s === 'encerrado') {
        return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">Encerrado</span>';
      }
      return '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-zinc-800 text-zinc-400">Aberto</span>';
    }

    function resolveProcessLinks(item) {
      const isDirectDoc = (url) => {
        if (!url || typeof url !== 'string' || !url.startsWith('http')) return false;
        const lower = url.toLowerCase();
        return (
          lower.includes('/arquivos/') ||
          lower.includes('.pdf') ||
          lower.includes('.zip') ||
          lower.includes('/sgdispensa/') ||
          lower.includes('/licitacao/id=') ||
          lower.includes('download')
        );
      };

      const isComprasPortal = (url) => {
        if (!url || typeof url !== 'string' || !url.startsWith('http')) return false;
        const lower = url.toLowerCase();
        return (
          lower.includes('compraspublicas.com.br') ||
          lower.includes('compras.gov.br') ||
          lower.includes('comprasnet') ||
          lower.includes('bllcompras.com') ||
          lower.includes('bll.org.br') ||
          lower.includes('licitanet.com.br') ||
          lower.includes('bbmnet.com.br') ||
          lower.includes('licitacoes-e.com.br') ||
          lower.includes('prefeitura') ||
          lower.includes('.gov.br')
        ) && !lower.includes('pncp.gov.br/app/editais');
      };

      // 1º Grau de Importância: Chamamento Público (Documento Direto)
      let chamamentoUrl = null;
      if (item.link_chamamento && item.link_chamamento.trim().startsWith('http')) {
        chamamentoUrl = item.link_chamamento.trim();
      } else if (isDirectDoc(item.link_fonte)) {
        chamamentoUrl = item.link_fonte.trim();
      } else if (isDirectDoc(item.link_edital)) {
        chamamentoUrl = item.link_edital.trim();
      }

      // 2º Grau de Importância: Portal de Compras Públicas / Portal da Prefeitura
      let portalComprasUrl = null;
      if (item.link_portal_compras && item.link_portal_compras.trim().startsWith('http')) {
        portalComprasUrl = item.link_portal_compras.trim();
      } else if (isComprasPortal(item.link_fonte)) {
        portalComprasUrl = item.link_fonte.trim();
      } else if (item.portal_prefeitura_url && item.portal_prefeitura_url.trim().startsWith('http')) {
        portalComprasUrl = item.portal_prefeitura_url.trim();
      }

      // 3º Grau de Importância: Edital / PNCP
      let editalUrl = null;
      if (item.link_edital && item.link_edital.trim().startsWith('http')) {
        editalUrl = item.link_edital.trim();
      } else if (item.link_fonte && item.link_fonte.trim().startsWith('http')) {
        editalUrl = item.link_fonte.trim();
      }

      return {
        chamamento: chamamentoUrl,
        compras: portalComprasUrl,
        edital: editalUrl
      };
    }

    const expandedCityGroups = new Set();

    window.toggleCityGroup = function(safeKey) {
      if (expandedCityGroups.has(safeKey)) {
        expandedCityGroups.delete(safeKey);
      } else {
        expandedCityGroups.add(safeKey);
      }

      const isExpanded = expandedCityGroups.has(safeKey);
      const childRows = document.querySelectorAll(`.child-row-${safeKey}`);
      childRows.forEach(row => {
        if (isExpanded) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });

      const chevrons = document.querySelectorAll(`.chevron-${safeKey}`);
      chevrons.forEach(ch => {
        ch.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
      });

      const btnTexts = document.querySelectorAll(`.btn-text-${safeKey}`);
      btnTexts.forEach(bt => {
        bt.textContent = isExpanded ? 'Recolher' : `Ver ${childRows.length} Editais`;
      });

      const masterRows = document.querySelectorAll(`.master-row-${safeKey}`);
      masterRows.forEach(mr => {
        if (isExpanded) {
          mr.classList.add('bg-zinc-900/90');
          mr.classList.remove('bg-zinc-950/40');
        } else {
          mr.classList.remove('bg-zinc-900/90');
          mr.classList.add('bg-zinc-950/40');
        }
      });
    };

    function renderTable() {
      const tbody = document.getElementById('table-body');
      const emptyState = document.getElementById('empty-state');
      const countEl = document.getElementById('results-count');

      const filtered = allEditais.filter(item => {
        if (activeChamamentoOnly && item.is_chamamento !== 1) return false;
        if (activeUf !== 'ALL' && item.uf !== activeUf) return false;
        if (activeSituacao !== 'ALL' && (item.situacao || '').toLowerCase() !== activeSituacao.toLowerCase()) return false;
        if (searchQuery.trim()) {
          const q = searchQuery.toLowerCase();
          const target = `${item.municipio} ${item.orgao} ${item.objeto} ${item.numero_edital} ${item.sistema_averbacao || ''}`.toLowerCase();
          if (!target.includes(q)) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        if (countEl) countEl.textContent = 'Exibindo 0 resultados';
        return;
      }
      emptyState.classList.add('hidden');

      // Agrupa editais por Cidade + UF
      const groupMap = new Map();
      for (const item of filtered) {
        const mKey = `${(item.municipio || '').trim().toLowerCase()}__${(item.uf || '').trim().toLowerCase()}`;
        if (!groupMap.has(mKey)) {
          const safeKey = mKey.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9_-]/g, '_');
          groupMap.set(mKey, {
            key: mKey,
            safeKey: safeKey,
            municipio: item.municipio,
            uf: item.uf,
            items: []
          });
        }
        groupMap.get(mKey).items.push(item);
      }
      const groups = Array.from(groupMap.values());

      const sitWeights = { 'aberto': 1, 'em andamento': 1, 'retificado': 2, 'suspenso': 3, 'encerrado': 4 };

      // Ordena itens dentro de cada grupo
      for (const g of groups) {
        g.items.sort((a, b) => {
          let res = 0;
          if (currentSortColumn === 'municipio') {
            res = (a.orgao || a.numero_edital || '').localeCompare(b.orgao || b.numero_edital || '', 'pt-BR');
          } else if (currentSortColumn === 'numero_edital') {
            res = (a.numero_edital || '').localeCompare(b.numero_edital || '', 'pt-BR', { numeric: true, sensitivity: 'base' });
          } else if (currentSortColumn === 'objeto') {
            res = (a.objeto || '').localeCompare(b.objeto || '', 'pt-BR', { sensitivity: 'base' });
          } else if (currentSortColumn === 'prazo_credenciamento') {
            res = parseDateValue(a.prazo_credenciamento || a.data_encerramento) - parseDateValue(b.prazo_credenciamento || b.data_encerramento);
          } else if (currentSortColumn === 'situacao') {
            const wA = sitWeights[a.situacao?.toLowerCase()] || 99;
            const wB = sitWeights[b.situacao?.toLowerCase()] || 99;
            res = wA - wB;
          }
          return currentSortDirection === 'desc' ? -res : res;
        });
      }

      // Ordena os grupos pela coluna ativa
      groups.sort((a, b) => {
        let res = 0;
        if (currentSortColumn === 'municipio') {
          res = (a.municipio || '').localeCompare(b.municipio || '', 'pt-BR', { sensitivity: 'base' });
          if (res === 0) res = (a.uf || '').localeCompare(b.uf || '', 'pt-BR');
        } else if (currentSortColumn === 'numero_edital') {
          res = (a.items[0]?.numero_edital || '').localeCompare(b.items[0]?.numero_edital || '', 'pt-BR', { numeric: true, sensitivity: 'base' });
        } else if (currentSortColumn === 'objeto') {
          res = (a.items[0]?.objeto || '').localeCompare(b.items[0]?.objeto || '', 'pt-BR', { sensitivity: 'base' });
        } else if (currentSortColumn === 'prazo_credenciamento') {
          const bestA = Math.max(...a.items.map(i => parseDateValue(i.prazo_credenciamento || i.data_encerramento)));
          const bestB = Math.max(...b.items.map(i => parseDateValue(i.prazo_credenciamento || i.data_encerramento)));
          res = bestA - bestB;
        } else if (currentSortColumn === 'situacao') {
          const wA = Math.min(...a.items.map(i => sitWeights[i.situacao?.toLowerCase()] || 99));
          const wB = Math.min(...b.items.map(i => sitWeights[i.situacao?.toLowerCase()] || 99));
          res = wA - wB;
        }
        return currentSortDirection === 'desc' ? -res : res;
      });

      // Atualiza footer com estatística de cidades e processos
      const multiCount = groups.filter(g => g.items.length > 1).length;
      if (countEl) {
        if (multiCount > 0) {
          countEl.textContent = `Exibindo ${groups.length} municípios (${filtered.length} processos catalogados · ${multiCount} com múltiplos editais)`;
        } else {
          countEl.textContent = `Exibindo ${filtered.length} processos catalogados`;
        }
      }

      // Renderiza as linhas
      tbody.innerHTML = groups.map(group => {
        const ufColors = {
          'GO': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
          'TO': 'bg-teal-500/10 text-teal-400 border-teal-500/20',
          'SP': 'bg-blue-500/10 text-blue-400 border-blue-500/20',
          'MG': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
          'BA': 'bg-orange-500/10 text-orange-400 border-orange-500/20',
          'PR': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
          'RJ': 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20',
        };
        const ufColor = ufColors[group.uf] || 'bg-zinc-800 text-zinc-300 border-zinc-700';

        // Inteligência de Servidores do Município
        const folha = getFolhaForMunicipio(group.municipio, group.uf);
        let folhaPill = '';
        if (folha && folha.total_servidores > 0) {
          const elegCount = folha.elegiveis_consignado ?? folha.servidores_elegiveis ?? 0;
          const elegPct = folha.elegiveis_pct || (folha.total_servidores > 0 ? Math.round((elegCount / folha.total_servidores) * 100) : 0);
          const sCount = folha.total_servidores > 999 ? (folha.total_servidores / 1000).toFixed(1) + 'k' : folha.total_servidores;
          folhaPill = `
            <div class="mt-1 flex items-center gap-1">
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title="${folha.total_servidores.toLocaleString('pt-BR')} servidores cadastrados · ${elegCount.toLocaleString('pt-BR')} elegíveis a consignado">
                <span>👥</span>
                <span>${sCount} serv.</span>
                <span class="text-zinc-600">·</span>
                <span class="font-bold text-emerald-300">${elegPct}% eleg.</span>
              </span>
              ${folha.link_folha_pagamento || folha.link_transparencia ? `
                <a
                  href="${folha.link_folha_pagamento || folha.link_transparencia}"
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick="event.stopPropagation()"
                  class="p-1 rounded bg-zinc-800/80 hover:bg-emerald-500 text-zinc-400 hover:text-zinc-950 transition border border-zinc-700/60 inline-flex items-center"
                  title="Abrir Folha / Transparência (${folha.sistema_transparencia || 'Municipal'})"
                >
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              ` : ''}
            </div>
          `;
        }

        // Função interna para renderizar links e botões de ação de um item
        function renderRowActions(item) {
          const links = resolveProcessLinks(item);

          const chamamentoHtml = links.chamamento
            ? `<a
                href="${links.chamamento}"
                target="_blank"
                rel="noopener noreferrer"
                onclick="event.stopPropagation()"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition shadow-sm cursor-pointer whitespace-nowrap"
                title="1º Prioridade: Baixar Documento Direto do Chamamento"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>1º Doc Chamamento</span>
              </a>`
            : `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium text-zinc-500 bg-zinc-950/80 border border-zinc-800 whitespace-nowrap" title="Chamamento direto não localizado">
                1º Chamamento: Não encontrado
              </span>`;

          const comprasHtml = links.compras
            ? `<a
                href="${links.compras}"
                target="_blank"
                rel="noopener noreferrer"
                onclick="event.stopPropagation()"
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/20 transition cursor-pointer whitespace-nowrap"
                title="2º Prioridade: Portal de Compras Públicas / Prefeitura"
              >
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span>2º Compras</span>
              </a>`
            : `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] text-zinc-500 bg-zinc-950/80 border border-zinc-800/80 whitespace-nowrap" title="Portal de compras não localizado">
                2º Compras: Não encontrado
              </span>`;

          const editalHtml = links.edital
            ? `<a
                href="${links.edital}"
                target="_blank"
                rel="noopener noreferrer"
                onclick="event.stopPropagation()"
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 transition cursor-pointer whitespace-nowrap"
                title="3º Prioridade: Publicação Oficial no PNCP"
              >
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>3º PNCP</span>
              </a>`
            : `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] text-zinc-500 bg-zinc-950/80 border border-zinc-800/80 whitespace-nowrap" title="Edital no PNCP não localizado">
                3º PNCP: Não encontrado
              </span>`;

          const detailHtml = `
            <button
              onclick="event.stopPropagation(); openDetail('${item.id}')"
              class="p-1 rounded-md bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition cursor-pointer ml-0.5"
              title="Ver Todas as 16 Colunas e Detalhes"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          `;

          return `
            <div class="flex items-center justify-end">
              ${chamamentoHtml}
            </div>
            <div class="flex items-center justify-end gap-1.5">
              ${comprasHtml}
              ${editalHtml}
              ${detailHtml}
            </div>
          `;
        }

        function getOriginBadge(item) {
          if (item.origem?.includes('+')) {
            return `<span class="inline-flex items-center gap-1 text-[10px] font-sans mt-0.5"><span class="text-cyan-400 font-bold">Portal</span><span class="text-zinc-500 font-bold">+</span><span class="text-emerald-400 font-bold">PNCP</span></span>`;
          } else if (item.origem?.includes('Portal')) {
            return `<span class="inline-flex items-center text-[10px] text-cyan-400 font-sans mt-0.5 font-bold">Portal da Prefeitura</span>`;
          } else if (item.origem?.includes('LicitaçõesPrefeitura')) {
            return `<span class="inline-flex items-center text-[10px] text-teal-400 font-sans mt-0.5 font-semibold">LicitaçõesPrefeitura</span>`;
          }
          return `<span class="inline-flex items-center text-[10px] text-zinc-400 font-sans mt-0.5">${item.origem || 'PNCP'}</span>`;
        }

        function getEmpBadge(item) {
          return item.tem_emprestimo === 'Sim'
            ? '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Sim</span>'
            : '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-zinc-800 text-zinc-500">Não</span>';
        }

        function getCardBadge(item) {
          if (item.tipo_cartao === 'Ambos') {
            return '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-teal-500/10 text-teal-300 border border-teal-500/20">Crédito + Benefício</span>';
          } else if (item.tipo_cartao === 'Cartão Benefício') {
            return '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">Benefício</span>';
          } else if (item.tipo_cartao === 'Cartão Consignado') {
            return '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">Crédito Consignado</span>';
          }
          return '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-zinc-800 text-zinc-500">Não</span>';
        }

        // CASO 1: CIDADE COM APENAS 1 EDITAL (Linha Padrão)
        if (group.items.length === 1) {
          const item = group.items[0];
          const prazoCred = item.prazo_credenciamento || item.data_encerramento || 'Conforme edital';

          return `
            <tr class="hover:bg-zinc-800/40 transition group">
              <td class="py-3 px-4 font-medium text-white whitespace-nowrap align-middle">
                <div class="flex items-center gap-1.5">
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold border ${ufColor}">
                    ${item.uf}
                  </span>
                  <span class="truncate max-w-[130px]" title="${item.municipio}">${item.municipio}</span>
                </div>
                ${folhaPill}
              </td>
              <td class="py-3 px-4 font-mono text-zinc-300 whitespace-nowrap align-middle">
                <span class="truncate block max-w-[140px] text-[11px] font-semibold">${item.numero_edital || 'não informado'} ${item.ano ? `(${item.ano})` : ''}</span>
                ${getOriginBadge(item)}
              </td>
              <td class="py-3 px-4 text-zinc-400 align-middle min-w-[260px] max-w-sm">
                <span class="line-clamp-2 leading-relaxed text-xs" title="${item.objeto}">
                  ${item.objeto}
                </span>
              </td>
              <td class="py-3 px-3 text-center whitespace-nowrap align-middle">
                ${getEmpBadge(item)}
              </td>
              <td class="py-3 px-3 text-center whitespace-nowrap align-middle">
                ${getCardBadge(item)}
              </td>
              <td class="py-3 px-4 text-center font-mono text-[11px] text-zinc-300 whitespace-nowrap align-middle">
                <span class="truncate block max-w-[130px]" title="${prazoCred}">${prazoCred}</span>
              </td>
              <td class="py-3 px-4 text-center whitespace-nowrap align-middle">
                ${getSituacaoBadge(item.situacao)}
              </td>
              <td class="py-3 px-4 text-right whitespace-nowrap align-middle">
                <div class="flex flex-col items-end gap-1.5 py-0.5">
                  ${renderRowActions(item)}
                </div>
              </td>
            </tr>
          `;
        }

        // CASO 2: CIDADE COM MÚLTIPLOS EDITAIS (Linha Mestre Agrupadora + Sublinhas Expansíveis)
        const isExpanded = expandedCityGroups.has(group.safeKey);
        const distinctOrgans = Array.from(new Set(group.items.map(i => i.orgao).filter(Boolean))).slice(0, 3);
        const hasEmp = group.items.some(i => i.tem_emprestimo === 'Sim');
        const hasCard = group.items.some(i => i.tipo_cartao && i.tipo_cartao !== 'Não');
        const openCount = group.items.filter(i => (i.situacao || '').toLowerCase() === 'aberto' || (i.situacao || '').toLowerCase() === 'em andamento').length;

        const masterRowHtml = `
          <tr
            class="master-row-${group.safeKey} hover:bg-zinc-800/60 transition group cursor-pointer border-b border-zinc-800/60 ${isExpanded ? 'bg-zinc-900/90' : 'bg-zinc-950/40'}"
            onclick="toggleCityGroup('${group.safeKey}')"
            title="Clique para expandir ou recolher os ${group.items.length} editais de ${group.municipio}"
          >
            <td class="py-3 px-4 font-medium text-white whitespace-nowrap align-middle">
              <div class="flex items-center gap-1.5">
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold border ${ufColor}">
                  ${group.uf}
                </span>
                <span class="font-bold text-white max-w-[130px] truncate" title="${group.municipio}">${group.municipio}</span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-500/15 text-amber-400 border border-amber-500/30">
                  <span>${group.items.length} editais</span>
                  <svg class="w-3 h-3 chevron-${group.safeKey} transition-transform duration-200" style="transform: ${isExpanded ? 'rotate(180deg)' : 'rotate(0deg)'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </div>
              ${folhaPill}
            </td>
            <td class="py-3 px-4 font-mono text-zinc-300 whitespace-nowrap align-middle">
              <span class="truncate block max-w-[140px] text-[11px] font-semibold text-amber-300">${group.items.length} processos</span>
              <span class="inline-flex items-center text-[10px] text-zinc-400 font-sans mt-0.5">Múltiplos órgãos</span>
            </td>
            <td class="py-3 px-4 text-zinc-400 align-middle min-w-[260px] max-w-sm">
              <div class="text-xs text-zinc-200 line-clamp-2 leading-relaxed">
                <span class="font-semibold text-amber-400">${group.items.length} editais identificados:</span> ${distinctOrgans.join(' · ')}${group.items.length > 3 ? '...' : ''}
              </div>
              <div class="text-[10px] text-zinc-500 mt-0.5 flex items-center gap-1">
                <span>Clique para expandir detalhes individuais</span>
              </div>
            </td>
            <td class="py-3 px-3 text-center whitespace-nowrap align-middle">
              ${hasEmp ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Sim (${group.items.filter(i => i.tem_emprestimo === 'Sim').length})</span>` : '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-zinc-800 text-zinc-500">Não</span>'}
            </td>
            <td class="py-3 px-3 text-center whitespace-nowrap align-middle">
              ${hasCard ? '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-teal-500/10 text-teal-300 border border-teal-500/20">Crédito / Benefício</span>' : '<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-zinc-800 text-zinc-500">Não</span>'}
            </td>
            <td class="py-3 px-4 text-center font-mono text-[11px] text-zinc-300 whitespace-nowrap align-middle">
              <span class="truncate block max-w-[130px] font-semibold text-zinc-300">${group.items.length} prazos</span>
            </td>
            <td class="py-3 px-4 text-center whitespace-nowrap align-middle">
              ${openCount === group.items.length
                ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">${openCount} Abertos</span>`
                : `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/20">${openCount} de ${group.items.length} Abertos</span>`}
            </td>
            <td class="py-3 px-4 text-right whitespace-nowrap align-middle">
              <div class="flex items-center justify-end">
                <button
                  type="button"
                  onclick="event.stopPropagation(); toggleCityGroup('${group.safeKey}')"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white border border-zinc-700 shadow-sm transition cursor-pointer"
                  title="Clique para ver os ${group.items.length} editais de ${group.municipio}"
                >
                  <svg class="w-3.5 h-3.5 chevron-${group.safeKey} transition-transform duration-200" style="transform: ${isExpanded ? 'rotate(180deg)' : 'rotate(0deg)'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                  <span class="btn-text-${group.safeKey}">${isExpanded ? 'Recolher' : `Ver ${group.items.length} Editais`}</span>
                </button>
              </div>
            </td>
          </tr>
        `;

        const childRowsHtml = group.items.map((item, idx) => {
          const prazoCred = item.prazo_credenciamento || item.data_encerramento || 'Conforme edital';

          return `
            <tr class="child-row-${group.safeKey} hover:bg-zinc-800/40 transition group bg-zinc-950/70 border-b border-zinc-800/40 ${isExpanded ? '' : 'hidden'}">
              <td class="py-2.5 px-4 whitespace-nowrap align-middle">
                <div class="flex items-center gap-2 pl-3 border-l-2 border-emerald-500/60">
                  <span class="text-[10px] font-mono text-zinc-400 font-bold bg-zinc-800 px-1.5 py-0.5 rounded">#${idx + 1}</span>
                  <div class="truncate max-w-[130px]">
                    <span class="text-xs text-zinc-200 font-semibold block truncate" title="${item.orgao || item.municipio}">${item.orgao || item.municipio}</span>
                    <span class="text-[10px] text-zinc-500 font-mono">${item.uf}</span>
                  </div>
                </div>
              </td>
              <td class="py-2.5 px-4 font-mono text-zinc-300 whitespace-nowrap align-middle">
                <span class="truncate block max-w-[140px] text-[11px] font-semibold">${item.numero_edital || 'não informado'} ${item.ano ? `(${item.ano})` : ''}</span>
                ${getOriginBadge(item)}
              </td>
              <td class="py-2.5 px-4 text-zinc-400 align-middle min-w-[260px] max-w-sm">
                <span class="line-clamp-2 leading-relaxed text-xs" title="${item.objeto}">
                  ${item.objeto}
                </span>
              </td>
              <td class="py-2.5 px-3 text-center whitespace-nowrap align-middle">
                ${getEmpBadge(item)}
              </td>
              <td class="py-2.5 px-3 text-center whitespace-nowrap align-middle">
                ${getCardBadge(item)}
              </td>
              <td class="py-2.5 px-4 text-center font-mono text-[11px] text-zinc-300 whitespace-nowrap align-middle">
                <span class="truncate block max-w-[130px]" title="${prazoCred}">${prazoCred}</span>
              </td>
              <td class="py-2.5 px-4 text-center whitespace-nowrap align-middle">
                ${getSituacaoBadge(item.situacao)}
              </td>
              <td class="py-2.5 px-4 text-right whitespace-nowrap align-middle">
                <div class="flex flex-col items-end gap-1.5 py-0.5">
                  ${renderRowActions(item)}
                </div>
              </td>
            </tr>
          `;
        }).join('');

        return masterRowHtml + childRowsHtml;
    }

    // Modal de Detalhes com todas as 16 colunas
    window.openDetail = function(id) {
      const item = allEditais.find(e => e.id === id);
      if (!item) return;

      document.getElementById('modal-uf-badge').textContent = item.uf;
      document.getElementById('modal-title').textContent = `${item.municipio} - ${item.numero_edital || 'Edital'}`;
      document.getElementById('modal-orgao').textContent = `${item.orgao} (${item.municipio} - ${item.uf})`;

      const chamBadge = document.getElementById('modal-chamamento-badge');
      if (chamBadge) {
        chamBadge.innerHTML = item.is_chamamento === 1
          ? '<span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Chamamento Público / Credenciamento</span>'
          : '<span class="px-2 py-0.5 rounded text-xs font-medium bg-zinc-800 text-zinc-400">Outra Modalidade</span>';
      }

      document.getElementById('modal-numero').textContent = `${item.numero_edital || 'não informado'} ${item.ano ? `(${item.ano})` : ''}`;
      document.getElementById('modal-emprestimo').innerHTML = `<span class="px-2 py-0.5 rounded text-xs font-bold ${item.tem_emprestimo === 'Sim' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-zinc-800 text-zinc-400'}">${item.tem_emprestimo || 'Não informado'}</span>`;
      document.getElementById('modal-cartao').innerHTML = `<span class="px-2 py-0.5 rounded text-xs font-bold ${item.tipo_cartao && item.tipo_cartao !== 'Não' ? 'bg-teal-500/10 text-teal-400 border border-teal-500/20' : 'bg-zinc-800 text-zinc-400'}">${item.tipo_cartao || 'Não'}</span>`;
      document.getElementById('modal-situacao').innerHTML = getSituacaoBadge(item.situacao);

      document.getElementById('modal-prazo-cred').textContent = item.prazo_credenciamento || item.data_encerramento || 'Conforme edital';
      document.getElementById('modal-publicacao').textContent = item.data_publicacao || 'não informado';
      document.getElementById('modal-encerramento').textContent = item.data_encerramento || 'não informado';

      document.getElementById('modal-averbacao').textContent = item.sistema_averbacao || 'A apurar na entidade';
      document.getElementById('modal-margem').textContent = item.margem_consignavel || '35% empréstimo + 5% cartão';
      document.getElementById('modal-prazo-max').textContent = item.prazo_maximo || '96 a 120 meses';
      document.getElementById('modal-taxa').textContent = item.taxa_limitacao || 'Teto BACEN / Fixado em edital';

      document.getElementById('modal-bancos').textContent = item.bancos_credenciados || 'Aberto a todas as instituições financeiras autorizadas pelo Bacen';
      document.getElementById('modal-documentacao').textContent = item.documentacao_exigida || 'Habilitação Jurídica, Regularidade Fiscal e Qualificação Técnica';
      document.getElementById('modal-contato').textContent = item.contato_orgao || 'Setor de Licitações / RH da Prefeitura';
      document.getElementById('modal-objeto').textContent = item.objeto;
      document.getElementById('modal-origem').textContent = `Fonte: ${item.origem || 'PNCP'} · Atualizado em ${new Date(item.updated_at || Date.now()).toLocaleDateString('pt-BR')}`;

      // SEÇÃO: RAIO-X DE SERVIDORES & POTENCIAL DE CONSIGNADO
      const folhaData = getFolhaForMunicipio(item.municipio, item.uf);
      const folhaSub = document.getElementById('modal-folha-sub');
      const folhaComp = document.getElementById('modal-folha-competencia');
      const folhaTotal = document.getElementById('modal-folha-total');
      const folhaElegiveis = document.getElementById('modal-folha-elegiveis');
      const folhaEfetivosPct = document.getElementById('modal-folha-efetivos-pct');
      const folhaBruta = document.getElementById('modal-folha-bruta');
      const folhaLiquida = document.getElementById('modal-folha-liquida');
      const folhaMargem = document.getElementById('modal-folha-margem');
      const folhaCartao = document.getElementById('modal-folha-cartao');
      const breakdownText = document.getElementById('modal-breakdown-text');
      const folhaFonte = document.getElementById('modal-folha-fonte');
      const folhaSistema = document.getElementById('modal-folha-sistema');
      const folhaTceNome = document.getElementById('modal-folha-tce-nome');
      const btnFolha = document.getElementById('modal-btn-folha');
      const btnTce = document.getElementById('modal-btn-tce');
      const barEfetivos = document.getElementById('modal-bar-efetivos');
      const barAposentados = document.getElementById('modal-bar-aposentados');
      const barComissionados = document.getElementById('modal-bar-comissionados');
      const barTemporarios = document.getElementById('modal-bar-temporarios');

      function updateModalFolhaUI(f) {
        if (!f) {
          if (folhaSub) folhaSub.textContent = `Apurando inteligência de folha para ${item.municipio}/${item.uf}...`;
          if (folhaComp) folhaComp.textContent = 'Em consulta';
          if (folhaTotal) folhaTotal.textContent = '—';
          if (folhaElegiveis) folhaElegiveis.textContent = '—';
          if (folhaEfetivosPct) folhaEfetivosPct.textContent = 'Quadro funcional';
          if (folhaBruta) folhaBruta.textContent = '—';
          if (folhaLiquida) folhaLiquida.textContent = 'Líquido: —';
          if (folhaMargem) folhaMargem.textContent = '—';
          if (folhaCartao) folhaCartao.textContent = 'Cartão: —';
          if (folhaSistema) folhaSistema.textContent = 'Mapeando Sistema...';
          if (folhaTceNome) folhaTceNome.textContent = 'Tribunal de Contas';
          if (btnFolha) {
            btnFolha.setAttribute('href', '#');
            btnFolha.classList.add('opacity-50', 'pointer-events-none');
          }
          if (btnTce) {
            btnTce.setAttribute('href', '#');
            btnTce.classList.add('opacity-50', 'pointer-events-none');
          }
          return;
        }

        const total = f.total_servidores || 0;
        const eleg = f.elegiveis_consignado ?? f.servidores_elegiveis ?? 0;
        const efet = f.total_efetivos ?? f.servidores_efetivos ?? 0;
        const inat = (f.total_aposentados || 0) + (f.total_pensionistas || 0) || f.servidores_aposentados || 0;
        const comiss = f.total_comissionados ?? f.servidores_comissionados ?? 0;
        const temp = f.total_temporarios ?? f.servidores_temporarios ?? 0;

        const elegPct = f.elegiveis_pct || (total > 0 ? Math.round((eleg / total) * 100) : 0);
        const efetPct = total > 0 ? Math.round((efet / total) * 100) : 0;
        const inatPct = total > 0 ? Math.round((inat / total) * 100) : 0;
        const comissPct = total > 0 ? Math.round((comiss / total) * 100) : 0;
        const tempPct = total > 0 ? Math.max(0, 100 - (efetPct + inatPct + comissPct)) : 0;

        const valFolhaBruta = f.valor_folha_bruta ?? f.folha_mensal_bruta ?? 0;
        const valFolhaLiquida = f.valor_folha_liquida ?? f.folha_mensal_liquida ?? 0;
        const valMargem35 = f.potencial_margem_35 || 0;
        const valMargemCartao5 = f.potencial_cartao_5 ?? f.potencial_margem_cartao_5 ?? 0;

        if (folhaSub) folhaSub.textContent = `Inteligência de Folha — ${f.municipio}/${f.uf} (${f.codigo_ibge ? `IBGE: ${f.codigo_ibge}` : 'Quadro Municipal'})`;
        if (folhaComp) folhaComp.textContent = `Competência: ${f.competencia || '2024-Q2 (Tesouro/RGF)'}`;
        if (folhaTotal) folhaTotal.textContent = total.toLocaleString('pt-BR');
        if (folhaElegiveis) folhaElegiveis.textContent = `${eleg.toLocaleString('pt-BR')} (${elegPct}%)`;
        if (folhaEfetivosPct) folhaEfetivosPct.textContent = `${efetPct}% Concursados/Efetivos`;
        if (folhaBruta) folhaBruta.textContent = `R$ ${valFolhaBruta.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (folhaLiquida) folhaLiquida.textContent = `Líquido est.: R$ ${valFolhaLiquida.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        if (folhaMargem) folhaMargem.textContent = `R$ ${valMargem35.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} /mês`;
        if (folhaCartao) folhaCartao.textContent = `Cartão (5%): R$ ${valMargemCartao5.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} /mês`;
        if (breakdownText) breakdownText.textContent = `${efet} Efetivos (${efetPct}%) · ${inat} Inativos (${inatPct}%) · ${comiss} Comissionados · ${temp} Temporários`;
        if (folhaFonte) folhaFonte.textContent = `Fonte: ${f.fonte_dados || f.fonte || 'Transparência Municipal / SICONFI'}`;

        if (folhaSistema) folhaSistema.textContent = f.sistema_transparencia || 'Transparência Municipal';
        if (folhaTceNome) folhaTceNome.textContent = f.link_tce ? 'Tribunal de Contas (TCE)' : 'Tribunal de Contas';

        if (btnFolha) {
          const targetUrl = f.link_folha_pagamento || f.link_transparencia;
          if (targetUrl) {
            btnFolha.setAttribute('href', targetUrl);
            btnFolha.classList.remove('opacity-50', 'pointer-events-none');
          } else {
            btnFolha.setAttribute('href', '#');
            btnFolha.classList.add('opacity-50', 'pointer-events-none');
          }
        }

        if (btnTce) {
          if (f.link_tce) {
            btnTce.setAttribute('href', f.link_tce);
            btnTce.classList.remove('opacity-50', 'pointer-events-none');
          } else {
            btnTce.setAttribute('href', '#');
            btnTce.classList.add('opacity-50', 'pointer-events-none');
          }
        }

        if (barEfetivos) barEfetivos.style.width = `${Math.max(5, efetPct)}%`;
        if (barAposentados) barAposentados.style.width = `${inatPct}%`;
        if (barComissionados) barComissionados.style.width = `${comissPct}%`;
        if (barTemporarios) barTemporarios.style.width = `${tempPct}%`;
      }

      updateModalFolhaUI(folhaData);

      // Se não constava na base inicial, consulta a API e atualiza em tempo real
      if (!folhaData) {
        fetch(`/api/transparencia/stats?municipio=${encodeURIComponent(item.municipio)}&uf=${item.uf || ''}`)
          .then(r => r.json())
          .then(data => {
            if (data && data.found && data.stats) {
              allFolhaStats.push(data.stats);
              updateModalFolhaUI(data.stats);
              renderTable();
            }
          })
          .catch(() => {});
      }

      // SEÇÃO DE LINKS HIERÁRQUICOS (1º Chamamento -> 2º Compras -> 3º Edital)
      const links = resolveProcessLinks(item);

      // 1º Prioridade: Chamamento Público (Documento Direto)
      const slotChamamento = document.getElementById('modal-slot-chamamento');
      if (slotChamamento) {
        if (links.chamamento) {
          slotChamamento.innerHTML = `
            <a
              href="${links.chamamento}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 transition shadow-md cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Baixar Documento Direto (PDF/Anexo)</span>
            </a>
          `;
        } else {
          slotChamamento.innerHTML = `
            <span class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-zinc-500 bg-zinc-900 border border-zinc-800 rounded-lg">
              Não encontrado
            </span>
          `;
        }
      }

      // 2º Prioridade: Portal de Compras Públicas / Prefeitura
      const slotCompras = document.getElementById('modal-slot-compras');
      if (slotCompras) {
        if (links.compras) {
          slotCompras.innerHTML = `
            <a
              href="${links.compras}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 border border-cyan-500/40 transition cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span>Acessar Portal de Compras / Licitações</span>
            </a>
          `;
        } else {
          slotCompras.innerHTML = `
            <span class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-zinc-500 bg-zinc-900 border border-zinc-800 rounded-lg">
              Não encontrado
            </span>
          `;
        }
      }

      // 3º Prioridade: Edital / PNCP
      const slotEdital = document.getElementById('modal-slot-edital');
      if (slotEdital) {
        if (links.edital) {
          slotEdital.innerHTML = `
            <a
              href="${links.edital}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 transition cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Ver Publicação Oficial (PNCP)</span>
            </a>
          `;
        } else {
          slotEdital.innerHTML = `
            <span class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-zinc-500 bg-zinc-900 border border-zinc-800 rounded-lg">
              Não encontrado
            </span>
          `;
        }
      }

      // Botões de Link no Footer
      const prefBtn = document.getElementById('modal-link-prefeitura');
      const secBtn = document.getElementById('modal-link-secundario');
      const ofcBtn = document.getElementById('modal-link-oficial');
      const ofcText = document.getElementById('modal-link-oficial-text');

      if (links.compras && prefBtn) {
        prefBtn.href = links.compras;
        prefBtn.classList.remove('hidden');
      } else if (prefBtn) {
        prefBtn.classList.add('hidden');
      }

      if (links.chamamento && secBtn) {
        secBtn.href = links.chamamento;
        const secText = document.getElementById('modal-link-secundario-text');
        if (secText) secText.textContent = 'Baixar Documento';
        secBtn.classList.remove('hidden');
      } else if (secBtn) {
        secBtn.classList.add('hidden');
      }

      if (ofcBtn) {
        if (links.edital) {
          ofcBtn.href = links.edital;
          ofcBtn.classList.remove('hidden');
        } else if (links.chamamento) {
          ofcBtn.href = links.chamamento;
          ofcBtn.classList.remove('hidden');
        } else {
          ofcBtn.classList.add('hidden');
        }
      }
      if (ofcText) {
        ofcText.textContent = item.origem?.includes('PNCP') ? 'Abrir no PNCP' : 'Abrir Fonte Oficial';
      }

      document.getElementById('detail-modal').classList.remove('hidden');
    };

    document.getElementById('modal-close').addEventListener('click', () => {
      document.getElementById('detail-modal').classList.add('hidden');
    });

    // Alternância de Abas (3 Abas: Editais, Prefeituras, Servidores)
    const tabBtnEditais = document.getElementById('tab-btn-editais');
    const tabBtnPref = document.getElementById('tab-btn-prefeituras');
    const tabBtnServidores = document.getElementById('tab-btn-servidores');
    const viewEditais = document.getElementById('view-editais');
    const viewPref = document.getElementById('view-prefeituras');
    const viewServidores = document.getElementById('view-servidores');

    function switchTab(tab) {
      activeTab = tab;
      const inactiveClass = 'inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm bg-zinc-900/60 hover:bg-zinc-800 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer';

      tabBtnEditais.className = inactiveClass;
      tabBtnPref.className = inactiveClass;
      tabBtnServidores.className = inactiveClass;

      viewEditais.classList.add('hidden');
      viewPref.classList.add('hidden');
      viewServidores.classList.add('hidden');

      if (tab === 'editais') {
        tabBtnEditais.className = 'inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm bg-emerald-500 text-zinc-950 shadow-md shadow-emerald-500/10 transition cursor-pointer';
        viewEditais.classList.remove('hidden');
      } else if (tab === 'prefeituras') {
        tabBtnPref.className = 'inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm bg-cyan-500 text-zinc-950 shadow-md shadow-cyan-500/10 transition cursor-pointer';
        viewPref.classList.remove('hidden');
        if (prefeiturasList.length === 0) loadPrefeituras();
      } else if (tab === 'servidores') {
        tabBtnServidores.className = 'inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-sm bg-emerald-500 text-zinc-950 shadow-md shadow-emerald-500/10 transition cursor-pointer';
        viewServidores.classList.remove('hidden');
        renderServidoresTable();
      }
    }

    tabBtnEditais.addEventListener('click', () => switchTab('editais'));
    tabBtnPref.addEventListener('click', () => switchTab('prefeituras'));
    tabBtnServidores.addEventListener('click', () => switchTab('servidores'));

    // Lógica da Aba Catálogo de Prefeituras
    async function loadPrefeituras() {
      const tbody = document.getElementById('pref-table-body');
      const countEl = document.getElementById('pref-results-count');
      tbody.innerHTML = '<tr><td colspan="7" class="py-8 text-center text-zinc-400">Carregando catálogo de prefeituras...</td></tr>';

      try {
        const url = `/api/prefeituras?uf=${prefActiveUf}&search=${encodeURIComponent(prefSearchQuery)}`;
        const res = await fetch(url);
        prefeiturasList = await res.json();

        countEl.textContent = `Exibindo ${prefeiturasList.length} municípios catalogados`;

        if (prefeiturasList.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="py-8 text-center text-zinc-500">Nenhum município localizado com os filtros selecionados.</td></tr>';
          return;
        }

        tbody.innerHTML = prefeiturasList.slice(0, 100).map(p => `
          <tr class="hover:bg-zinc-800/40 transition">
            <td class="py-2.5 px-4 font-medium text-white">${p.municipio}</td>
            <td class="py-2.5 px-3 text-center"><span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-zinc-800 text-zinc-300">${p.uf}</span></td>
            <td class="py-2.5 px-3 text-zinc-400">${p.regiao}</td>
            <td class="py-2.5 px-3 font-mono text-zinc-500 text-[11px]">${p.codigo_ibge}</td>
            <td class="py-2.5 px-4 font-mono text-[11px]">
              ${p.portal_url ? `<a href="${p.portal_url}" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:underline flex items-center gap-1">${p.portal_url.replace('https://', '')} <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a>` : '<span class="text-zinc-600">Padrão .gov.br</span>'}
            </td>
            <td class="py-2.5 px-4 font-mono text-[11px]">
              ${p.licitacoes_url ? `<a href="${p.licitacoes_url}" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline flex items-center gap-1">Acessar Licitações <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></a>` : '<span class="text-zinc-600">Portal da Transparência</span>'}
            </td>
            <td class="py-2.5 px-3 text-center">
              <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Catalogado</span>
            </td>
          </tr>
        `).join('');

        if (prefeiturasList.length > 100) {
          countEl.textContent = `Exibindo primeiros 100 de ${prefeiturasList.length} municípios (filtre por nome ou UF para refinar)`;
        }
      } catch (err) {
        tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-rose-400">Erro ao carregar catálogo: ${err.message}</td></tr>`;
      }
    }

    document.getElementById('search-pref-input')?.addEventListener('input', (e) => {
      prefSearchQuery = e.target.value;
      loadPrefeituras();
    });

    document.getElementById('pref-uf-select')?.addEventListener('change', (e) => {
      prefActiveUf = e.target.value;
      loadPrefeituras();
    });

    // Lógica da Aba Servidores & Transparência
    function renderServidoresTable() {
      const tbody = document.getElementById('serv-table-body');
      const countEl = document.getElementById('serv-results-count');
      if (!tbody) return;

      const filtered = allFolhaStats.filter(item => {
        if (servActiveUf !== 'ALL' && item.uf !== servActiveUf) return false;
        if (servSearchQuery.trim()) {
          const q = servSearchQuery.toLowerCase();
          const target = `${item.municipio} ${item.uf} ${item.codigo_ibge || ''} ${item.fonte || ''}`.toLowerCase();
          if (!target.includes(q)) return false;
        }
        return true;
      });

      // Atualiza KPIs agregados da folha
      let sumServidores = 0;
      let sumElegiveis = 0;
      let sumFolhaBruta = 0;
      let sumMargem35 = 0;
      let sumMargemCartao = 0;

      for (const it of filtered) {
        sumServidores += (it.total_servidores || 0);
        sumElegiveis += (it.elegiveis_consignado ?? it.servidores_elegiveis ?? 0);
        sumFolhaBruta += (it.valor_folha_bruta ?? it.folha_mensal_bruta ?? 0);
        sumMargem35 += (it.potencial_margem_35 || 0);
        sumMargemCartao += (it.potencial_cartao_5 ?? it.potencial_margem_cartao_5 ?? 0);
      }

      const kpiServ = document.getElementById('kpi-folha-servidores');
      const kpiEleg = document.getElementById('kpi-folha-elegiveis');
      const kpiMassa = document.getElementById('kpi-folha-massa');
      const kpiMargem = document.getElementById('kpi-folha-margem');
      const kpiCartao = document.getElementById('kpi-folha-cartao');

      if (kpiServ) kpiServ.textContent = sumServidores.toLocaleString('pt-BR');
      if (kpiEleg) {
        const pct = sumServidores > 0 ? Math.round((sumElegiveis / sumServidores) * 100) : 0;
        kpiEleg.textContent = `${sumElegiveis.toLocaleString('pt-BR')} (${pct}%)`;
      }
      if (kpiMassa) kpiMassa.textContent = `R$ ${sumFolhaBruta.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      if (kpiMargem) kpiMargem.textContent = `R$ ${sumMargem35.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      if (kpiCartao) kpiCartao.textContent = `+ R$ ${sumMargemCartao.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Cartão Benefício (5%)`;

      if (countEl) countEl.textContent = `Exibindo ${filtered.length} de ${allFolhaStats.length} entidades municipais com inteligência de folha`;

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="py-8 text-center text-zinc-500">Nenhum município localizado com os filtros selecionados.</td></tr>';
        return;
      }

      // Ordena por potencial de margem 35% decrescente
      filtered.sort((a, b) => (b.potencial_margem_35 || 0) - (a.potencial_margem_35 || 0));

      tbody.innerHTML = filtered.map(item => {
        const total = item.total_servidores || 0;
        const eleg = item.elegiveis_consignado ?? item.servidores_elegiveis ?? 0;
        const efet = item.total_efetivos ?? item.servidores_efetivos ?? 0;
        const inat = (item.total_aposentados || 0) + (item.total_pensionistas || 0) || item.servidores_aposentados || 0;
        const comiss = item.total_comissionados ?? item.servidores_comissionados ?? 0;
        const temp = item.total_temporarios ?? item.servidores_temporarios ?? 0;

        const elegPct = item.elegiveis_pct || (total > 0 ? Math.round((eleg / total) * 100) : 0);
        const efetPct = total > 0 ? Math.round((efet / total) * 100) : 0;
        const inatPct = total > 0 ? Math.round((inat / total) * 100) : 0;
        const comissPct = total > 0 ? Math.round((comiss / total) * 100) : 0;
        const tempPct = total > 0 ? Math.max(0, 100 - (efetPct + inatPct + comissPct)) : 0;

        const folhaBruta = item.valor_folha_bruta ?? item.folha_mensal_bruta ?? 0;
        const folhaLiq = item.valor_folha_liquida ?? item.folha_mensal_liquida ?? 0;
        const margem35 = item.potencial_margem_35 || 0;
        const cartao5 = item.potencial_cartao_5 ?? item.potencial_margem_cartao_5 ?? 0;

        const ufColors = {
          'GO': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
          'TO': 'bg-teal-500/10 text-teal-400 border-teal-500/20',
          'SP': 'bg-blue-500/10 text-blue-400 border-blue-500/20',
          'MG': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
          'BA': 'bg-orange-500/10 text-orange-400 border-orange-500/20',
          'PR': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
          'RJ': 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20',
        };
        const ufColor = ufColors[item.uf] || 'bg-zinc-800 text-zinc-300 border-zinc-700';

        return `
          <tr class="hover:bg-zinc-800/40 transition">
            <td class="py-3 px-4 font-medium text-white whitespace-nowrap">
              <div class="flex items-center gap-1.5">
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold border ${ufColor}">
                  ${item.uf}
                </span>
                <span class="font-bold text-zinc-100">${item.municipio}</span>
              </div>
              <span class="text-[10px] text-zinc-500 font-mono block mt-0.5">${item.codigo_ibge ? `IBGE: ${item.codigo_ibge}` : ''} ${item.sistema_transparencia ? `· ${item.sistema_transparencia}` : ''}</span>
            </td>

            <td class="py-3 px-3 text-right whitespace-nowrap">
              <span class="text-sm font-extrabold text-white font-mono">${total.toLocaleString('pt-BR')}</span>
              <span class="text-[10px] text-emerald-400 font-mono block font-semibold">${eleg.toLocaleString('pt-BR')} elegíveis (${elegPct}%)</span>
            </td>

            <td class="py-3 px-4">
              <div class="space-y-1">
                <div class="w-full h-2 rounded-full bg-zinc-800 flex overflow-hidden">
                  <div class="bg-emerald-500 h-full" style="width: ${Math.max(5, efetPct)}%;" title="Efetivos: ${efet} (${efetPct}%)"></div>
                  <div class="bg-blue-500 h-full" style="width: ${inatPct}%;" title="Inativos: ${inat} (${inatPct}%)"></div>
                  <div class="bg-purple-500 h-full" style="width: ${comissPct}%;" title="Comissionados: ${comiss} (${comissPct}%)"></div>
                  <div class="bg-amber-500 h-full" style="width: ${tempPct}%;" title="Temporários: ${temp} (${tempPct}%)"></div>
                </div>
                <div class="flex items-center gap-2 text-[10px] text-zinc-400">
                  <span class="text-emerald-400 font-medium">${efetPct}% Concursados</span>
                  <span>·</span>
                  <span class="text-purple-400 font-medium">${comissPct}% Comiss.</span>
                  <span>·</span>
                  <span class="text-amber-400 font-medium">${tempPct}% PSS</span>
                </div>
              </div>
            </td>

            <td class="py-3 px-3 text-right font-mono whitespace-nowrap">
              <span class="text-xs font-bold text-zinc-200">R$ ${folhaBruta.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
              <span class="text-[10px] text-zinc-500 block">Líq: R$ ${folhaLiq.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
            </td>

            <td class="py-3 px-3 text-right font-mono whitespace-nowrap">
              <span class="text-xs font-black text-emerald-400">R$ ${margem35.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
              <span class="text-[10px] text-emerald-500/80 block">35% Empréstimo</span>
            </td>

            <td class="py-3 px-3 text-right font-mono whitespace-nowrap">
              <span class="text-xs font-bold text-teal-400">R$ ${cartao5.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
              <span class="text-[10px] text-teal-500/80 block">5% Cartão</span>
            </td>

            <td class="py-3 px-3 text-center whitespace-nowrap">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-zinc-950 text-zinc-400 border border-zinc-800">
                ${item.competencia || '2024-Q2'}
              </span>
            </td>

            <td class="py-3 px-3 text-center whitespace-nowrap">
              <div class="flex items-center justify-center gap-1.5">
                ${(item.link_folha_pagamento || item.link_transparencia) ? `
                  <a
                    href="${item.link_folha_pagamento || item.link_transparencia}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500 text-emerald-400 hover:text-zinc-950 transition border border-emerald-500/20 inline-flex items-center justify-center cursor-pointer"
                    title="Acessar Folha de Pagamento / Transparência (${item.sistema_transparencia || 'Municipal'})"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ` : ''}

                ${item.link_tce ? `
                  <a
                    href="${item.link_tce}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1.5 rounded-lg bg-indigo-500/10 hover:bg-indigo-500 text-indigo-300 hover:text-white transition border border-indigo-500/20 inline-flex items-center justify-center cursor-pointer"
                    title="Consultar no Tribunal de Contas (${item.uf})"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  </a>
                ` : ''}

                <button
                  onclick="syncSingleFolha('${item.municipio}', '${item.uf}')"
                  class="px-2 py-1 text-[10px] font-bold rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 transition cursor-pointer border border-zinc-700"
                  title="Sincronizar dados de transparência e SICONFI"
                >
                  Sync
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    window.syncSingleFolha = async function(municipio, uf) {
      try {
        const res = await fetch('/api/transparencia/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ municipio, uf })
        });
        const data = await res.json();
        if (data && data.success && data.stats) {
          const idx = allFolhaStats.findIndex(f => f.municipio.toLowerCase() === municipio.toLowerCase() && f.uf === uf);
          if (idx >= 0) {
            allFolhaStats[idx] = data.stats;
          } else {
            allFolhaStats.push(data.stats);
          }
          renderServidoresTable();
          renderTable();
          alert(`Inteligência de folha atualizada para ${municipio}/${uf}!`);
        } else {
          alert(`Aviso: ${data.message || 'Não foi possível sincronizar no momento.'}`);
        }
      } catch (e) {
        alert('Erro ao sincronizar folha: ' + e.message);
      }
    };

    document.getElementById('search-serv-input')?.addEventListener('input', (e) => {
      servSearchQuery = e.target.value;
      renderServidoresTable();
    });

    document.getElementById('serv-uf-select')?.addEventListener('change', (e) => {
      servActiveUf = e.target.value;
      renderServidoresTable();
    });

    // Sincronizar toda a folha de editais ativos
    document.getElementById('btn-sync-all-folha')?.addEventListener('click', async () => {
      const btn = document.getElementById('btn-sync-all-folha');
      const text = document.getElementById('sync-folha-text');
      const spinner = document.getElementById('sync-folha-spinner');

      btn.disabled = true;
      text.textContent = 'Sincronizando...';
      spinner.classList.add('animate-spin');

      try {
        const res = await fetch('/api/transparencia/sync', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ all: true })
        });
        const json = await res.json();

        // Recarrega estatísticas atualizadas
        const statsRes = await fetch('/api/transparencia/stats');
        allFolhaStats = await statsRes.json();
        renderServidoresTable();
        renderTable();

        alert(json.message || 'Varredura de folha concluída com sucesso!');
      } catch (err) {
        alert('Erro ao sincronizar folha: ' + err.message);
      } finally {
        btn.disabled = false;
        text.textContent = 'Sincronizar Folha Ativa';
        spinner.classList.remove('animate-spin');
      }
    });

    // Filtros de Chamamento
    const btnChamOnly = document.getElementById('btn-filter-chamamento-only');
    const btnChamAll = document.getElementById('btn-filter-chamamento-all');

    btnChamOnly.addEventListener('click', () => {
      activeChamamentoOnly = true;
      btnChamOnly.className = 'inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-lg bg-emerald-500 text-zinc-950 transition cursor-pointer';
      btnChamAll.className = 'inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer';
      renderTable();
    });

    btnChamAll.addEventListener('click', () => {
      activeChamamentoOnly = false;
      btnChamAll.className = 'inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-lg bg-emerald-500 text-zinc-950 transition cursor-pointer';
      btnChamOnly.className = 'inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer';
      renderTable();
    });

    // Dropdown de Exportação
    const exportBtn = document.getElementById('export-btn');
    const exportMenu = document.getElementById('export-menu');
    exportBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      exportMenu.classList.toggle('hidden');
    });
    document.addEventListener('click', () => {
      exportMenu.classList.add('hidden');
    });

    // Filtros de UF (Botões Rápidos)
    document.querySelectorAll('.filter-uf-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-uf-btn').forEach(b => {
          b.className = 'filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer';
        });
        btn.className = 'filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-emerald-500 text-zinc-950 transition cursor-pointer';
        activeUf = btn.getAttribute('data-uf');
        const stateSelect = document.getElementById('state-select');
        if (stateSelect) stateSelect.value = activeUf;
        renderTable();
      });
    });

    // Dropdown de Todas as UFs
    document.getElementById('state-select')?.addEventListener('change', (e) => {
      activeUf = e.target.value;
      document.querySelectorAll('.filter-uf-btn').forEach(b => {
        if (b.getAttribute('data-uf') === activeUf) {
          b.className = 'filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-emerald-500 text-zinc-950 transition cursor-pointer';
        } else {
          b.className = 'filter-uf-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer';
        }
      });
      renderTable();
    });

    // Filtros de Situação
    document.querySelectorAll('.filter-sit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-sit-btn').forEach(b => {
          b.className = 'filter-sit-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-950 text-zinc-400 hover:text-zinc-200 border border-zinc-800 transition cursor-pointer';
        });
        btn.className = 'filter-sit-btn px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-800 text-zinc-100 transition cursor-pointer';
        activeSituacao = btn.getAttribute('data-situacao');
        renderTable();
      });
    });

    // Campo de busca
    document.getElementById('search-input')?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      renderTable();
    });

    // Botão Ver Relatório Markdown
    document.getElementById('btn-open-report')?.addEventListener('click', async () => {
      const modal = document.getElementById('report-modal');
      const contentEl = document.getElementById('report-content');
      modal.classList.remove('hidden');
      contentEl.textContent = 'Gerando relatório oficial com 16 colunas formatadas...';

      try {
        const res = await fetch('/api/export?format=markdown');
        const text = await res.text();
        contentEl.textContent = text;
      } catch (err) {
        contentEl.textContent = 'Erro ao carregar relatório: ' + err.message;
      }
    });

    document.getElementById('report-modal-close')?.addEventListener('click', () => {
      document.getElementById('report-modal').classList.add('hidden');
    });

    // Botão Copiar Markdown
    document.getElementById('btn-copy-md')?.addEventListener('click', async () => {
      const content = document.getElementById('report-content').textContent;
      await navigator.clipboard.writeText(content);
      const copyText = document.getElementById('copy-text');
      const old = copyText.textContent;
      copyText.textContent = 'Copiado!';
      setTimeout(() => copyText.textContent = old, 2000);
    });

    // Botão Sincronizar Agora
    document.getElementById('btn-sync-now')?.addEventListener('click', async () => {
      const btn = document.getElementById('btn-sync-now');
      const text = document.getElementById('sync-text');
      const spinner = document.getElementById('sync-spinner');

      btn.disabled = true;
      text.textContent = 'Iniciando varredura...';
      spinner.classList.add('animate-spin');

      try {
        const res = await fetch('/api/sync', { method: 'POST' });
        const json = await res.json();
        if (json.success) {
          text.textContent = 'Varrendo fontes...';
          // Polling periódico a cada 4 segundos para atualizar os resultados em tempo real
          let polls = 0;
          const pollInterval = setInterval(async () => {
            polls++;
            try {
              const resEditais = await fetch('/api/editais');
              allEditais = await resEditais.json();
              renderTable();

              const resHealth = await fetch('/api/health');
              const hJson = await resHealth.json();
              if (hJson.stats) {
                document.getElementById('stat-total').textContent = hJson.stats.total;
                document.getElementById('stat-chamamentos').textContent = hJson.stats.totalChamamentos;
                document.getElementById('stat-abertos').textContent = hJson.stats.abertosBrasil;
                document.getElementById('stat-prefeituras').textContent = hJson.stats.prefeiturasCatalogadas;
                document.getElementById('stat-novos').textContent = hJson.stats.novosHoje;
              }
            } catch (e) {
              console.warn('Polling error:', e);
            }

            if (polls >= 6) {
              clearInterval(pollInterval);
              btn.disabled = false;
              text.textContent = 'Varredura Agora';
              spinner.classList.remove('animate-spin');
            }
          }, 4000);
        } else {
          alert('Erro na varredura: ' + (json.error || 'Erro desconhecido'));
          btn.disabled = false;
          text.textContent = 'Varredura Agora';
          spinner.classList.remove('animate-spin');
        }
      } catch (err) {
        alert('Erro ao conectar com o serviço: ' + err.message);
        btn.disabled = false;
        text.textContent = 'Varredura Agora';
        spinner.classList.remove('animate-spin');
      }
    });

    // Listeners de ordenação das colunas
    document.querySelectorAll('th[data-sort]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.getAttribute('data-sort');
        if (currentSortColumn === col) {
          currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
        } else {
          currentSortColumn = col;
          currentSortDirection = (col === 'prazo_credenciamento' || col === 'situacao') ? 'desc' : 'asc';
        }
        updateSortIcons();
        renderTable();
      });
    });

    // Render inicial e ícones
    updateSortIcons();
    renderTable();
  </script>
</Layout>
